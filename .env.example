# Copy to .env and replace the local password. Use unquoted KEY=value entries.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fincore
POSTGRES_DEV_DB=fincore_dev
POSTGRES_USER=fincore
POSTGRES_PASSWORD=change_me_local

# Local server. Transfer ownership/idempotency is pending Phase 7B.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Swagger is available in dev; default denies its HTTP routes.
# OPENAPI_ENABLED=false
# SWAGGER_UI_ENABLED=false

# Required for HTTP startup: external PEM URI (PKCS8 private / X509 public).
# Use different key pairs for default and dev. Never commit key material.
FINCORE_JWT_PRIVATE_KEY=
FINCORE_JWT_PUBLIC_KEY=

# Required only when first provisioning demo users in dev + seed.enabled=true.
# Supply actual passwords through external secrets/environment, not Git.
FINCORE_DEMO_ALEJANDRO_PASSWORD=
FINCORE_DEMO_FERNANDO_PASSWORD=
